{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PlaySpot (Debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=SUPABASE_URL=https://tgpdexoitemmpruepgyt.supabase.co",
        "--dart-define=SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY"
      ]
    },
    {
      "name": "PlaySpot Mobile - Isolated loopback acceptance (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--no-pub",
        "--web-port=51652",
        "--dart-define-from-file=${workspaceFolder}/.env.isolated.json"
      ]
    },
    {
      "name": "PlaySpot Mobile - Isolated USB Android (select Android device)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--no-pub",
        "--dart-define-from-file=${workspaceFolder}/.env.isolated.json",
        "--android-project-arg=localAcceptanceBuild=true"
      ]
    },
    {
      "name": "PlaySpot Mobile - Consolidated dev (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--no-pub",
        "--web-port=51752",
        "--dart-define-from-file=${workspaceFolder}/.env.dev-local.json"
      ]
    },
    {
      "name": "PlaySpot Mobile - Consolidated dev (Android)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": [
        "--no-pub",
        "--dart-define-from-file=${workspaceFolder}/.env.dev-local.json",
        "--android-project-arg=localAcceptanceBuild=true"
      ]
    }
  ]
}
