# PlaySpot Environment Variables Example
# Duplicate this file as .env or use --dart-define during build:
# flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
GOOGLE_API_KEY_IOS=your-google-api-key-ios
GOOGLE_API_KEY_ANDROID=your-google-api-key-android
